# .gitattributes

# Aliases
[attr]lfs filter=lfs diff=lfs merge=lfs -text
[attr]crlf eol=crlf

# Normalize
* text=auto eol=lf

# Windows
# *.bat crlf

# LFS, binary files
*.png lfs
*.zip lfs

# GitLab: syntax highlight
*.cfg            gitlab-language=javascript
*.code-workspace gitlab-language=json
*.jsonc          gitlab-language=json
*.plist          gitlab-language=xml
flake.lock       gitlab-language=json
permissions      gitlab-language=ini
_redirects       gitlab-language=ini

# GitHub & Codeberg: languages and diffs
*.cfg            linguist-language=JAVASCRIPT
*.code-workspace linguist-language=JSON
*.jsonc          linguist-language=JSON
*.plist          linguist-language=XML
flake.lock       linguist-language=JSON
permissions      linguist-language=INI
_redirects       linguist-language=INI

# Statistics
*.json  linguist-detectable
# *.md  linguist-detectable
