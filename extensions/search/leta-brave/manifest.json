{
    "name": "Mullvad Leta (Brave)",
    "description": "Search Mullvad Leta (with Brave's index)",
    "manifest_version": 3,
    "version": "0.0.1",
    "browser_specific_settings": {
        "gecko": {
            "id": "brave-leta@celenity.dev",
            "update_url": "https://codeberg.org/celenity/Phoenix/raw/branch/pages/extensions/updates.json"
        }
    },
    "hidden": true,
    "chrome_settings_overrides": {
        "search_provider": {
            "keyword": [
                "@letab",
                "@letabrave"
            ],
            "name": "Mullvad Leta (Brave)",
            "search_url": "https://leta.mullvad.net/?q={searchTerms}&engine=brave",
            "favicon_url": "/imager/favicon.ico",
            "is_default": false
        }
    },
    "author": "celenity 💘 <celenity@celenity.dev>",
    "homepage_url": "https://phoenix.celenity.dev/search",
    "icons": {
        "48": "imager/icon.png"
    }
}
