{
    "name": "Startpage",
    "description": "Search Startpage",
    "manifest_version": 3,
    "version": "0.0.5",
    "browser_specific_settings": {
        "gecko": {
            "id": "startpage@celenity.dev",
            "update_url": "https://gitlab.com/celenityy/Phoenix/-/raw/pages/extensions/updates.json"
        }
    },
    "hidden": true,
    "chrome_settings_overrides": {
        "search_provider": {
            "keyword": [
                "@startpage",
                "@sp"
            ],
            "name": "Startpage",
            "search_url": "https://www.startpage.com/sp/search?query={searchTerms}",
            "suggest_url": "https://www.startpage.com/osuggestions?q={searchTerms}",
            "favicon_url": "/imager/favicon.ico",
            "is_default": false
        }
    },
    "author": "celenity 💘 <celenity@celenity.dev>",
    "homepage_url": "https://phoenix.celenity.dev/search",
    "icons": {
        "48": "imager/icon.png"
    }
}
