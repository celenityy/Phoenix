{
    "name": "Mullvad Leta (Google)",
    "description": "Search Mullvad Leta (with Google's index)",
    "manifest_version": 3,
    "version": "0.0.2",
    "browser_specific_settings": {
        "gecko": {
            "id": "google-leta@celenity.dev",
            "update_url": "https://gitlab.com/celenityy/Phoenix/-/raw/pages/extensions/updates.json"
        }
    },
    "hidden": true,
    "chrome_settings_overrides": {
        "search_provider": {
            "keyword": [
                "@letag",
                "@letagoogle"
            ],
            "name": "Mullvad Leta (Google)",
            "search_url": "https://leta.mullvad.net/?q={searchTerms}&engine=google",
            "favicon_url": "/imager/favicon.ico",
            "is_default": false
        }
    },
    "author": "celenity 💘 <celenity@celenity.dev>",
    "homepage_url": "https://phoenix.celenity.dev/search",
    "icons": {
        "48": "imager/icon.png"
    }
}
