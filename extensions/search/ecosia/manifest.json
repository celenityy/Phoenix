{
    "name": "Ecosia",
    "description": "Search Ecosia",
    "manifest_version": 3,
    "version": "0.0.3",
    "browser_specific_settings": {
        "gecko": {
            "id": "ecosia@celenity.dev",
            "update_url": "https://phoenix.celenity.dev/extensions/updates.json"
        }
    },
    "hidden": true,
    "chrome_settings_overrides": {
        "search_provider": {
            "keyword": [
                "@ecosia"
            ],
            "name": "Ecosia",
            "search_url": "https://www.ecosia.org/search?q={searchTerms}",
            "suggest_url": "https://ac.ecosia.org/autocomplete?q={searchTerms}&type=list",
            "favicon_url": "/imager/favicon.ico",
            "is_default": false
        }
    },
    "author": "celenity 💘 <celenity@celenity.dev>",
    "homepage_url": "https://phoenix.celenity.dev",
    "icons": {
        "48": "imager/icon.png"
    }
}