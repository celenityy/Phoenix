{
    "name": "DuckDuckGo (HTML)",
    "description": "Search DuckDuckGo (HTML)",
    "manifest_version": 3,
    "version": "0.0.7",
    "browser_specific_settings": {
        "gecko": {
            "id": "duckduckgo-html@celenity.dev",
            "update_url": "https://gitlab.com/celenityy/Phoenix/-/raw/pages/extensions/updates.json"
        }
    },
    "hidden": true,
    "chrome_settings_overrides": {
        "search_provider": {
            "keyword": [
                "@duckduckgohtml",
                "@ddghtml"
            ],
            "name": "DuckDuckGo (HTML)",
            "search_url": "https://html.duckduckgo.com/html/?q={searchTerms}",
            "suggest_url": "https://duckduckgo.com/ac/?q={searchTerms}&type=list",
            "favicon_url": "/imager/favicon.ico",
            "is_default": false
        }
    },
    "author": "celenity 💘 <celenity@celenity.dev>",
    "homepage_url": "https://phoenix.celenity.dev/search",
    "icons": {
        "48": "imager/icon.png"
    }
}
