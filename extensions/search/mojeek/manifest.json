{
    "name": "Mojeek",
    "description": "Search Mojeek",
    "manifest_version": 3,
    "version": "0.0.3",
    "browser_specific_settings": {
        "gecko": {
            "id": "mojeek@celenity.dev",
            "update_url": "https://phoenix.celenity.dev/extensions/updates.json"
        }
    },
    "hidden": true,
    "chrome_settings_overrides": {
        "search_provider": {
            "keyword": [
                "@mojeek"
            ],
            "name": "Mojeek",
            "search_url": "https://www.mojeek.com/search?q={searchTerms}",
            "favicon_url": "/imager/favicon.png",
            "is_default": false
        }
    },
    "author": "celenity 💘 <celenity@celenity.dev>",
    "homepage_url": "https://phoenix.celenity.dev",
    "icons": {
        "48": "imager/icon.png"
    }
}