{
    "name": "DuckDuckGo",
    "description": "Search DuckDuckGo",
    "manifest_version": 3,
    "version": "0.0.2",
    "browser_specific_settings": {
        "gecko": {
            "id": "ddg@celenity.dev",
            "update_url": "https://codeberg.org/celenity/Phoenix/raw/branch/pages/extensions/updates.json"
        }
    },
    "hidden": true,
    "chrome_settings_overrides": {
        "search_provider": {
            "name": "DuckDuckGo",
            "search_url": "https://duckduckgo.com/?q={searchTerms}",
            "is_default": true
        }
    },
    "author": "celenity 💘 <celenity@celenity.dev>",
    "homepage_url": "https://phoenix.celenity.dev/search",
    "icons": {
        "48": "imager/icon.png"
    }
}
