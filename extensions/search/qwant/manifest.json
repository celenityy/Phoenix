{
    "name": "Qwant",
    "description": "Search Qwant",
    "manifest_version": 3,
    "version": "0.0.3",
    "browser_specific_settings": {
        "gecko": {
            "id": "qwant@celenity.dev",
            "update_url": "https://phoenix.celenity.dev/extensions/updates.json"
        }
    },
    "hidden": true,
    "chrome_settings_overrides": {
        "search_provider": {
            "keyword": [
                "@qwant"
            ],
            "name": "Qwant",
            "search_url": "https://www.qwant.com?q={searchTerms}",
            "suggest_url": "https://api.qwant.com/v3/suggest/?q={searchTerms}",
            "favicon_url": "/imager/favicon.ico",
            "is_default": false
        }
    },
    "author": "celenity 💘 <celenity@celenity.dev>",
    "homepage_url": "https://phoenix.celenity.dev",
    "icons": {
        "48": "imager/icon.png"
    }
}