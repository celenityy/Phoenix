{
    "name": "DuckDuckGo Lite",
    "description": "Search DuckDuckGo Lite",
    "manifest_version": 3,
    "version": "0.0.3",
    "browser_specific_settings": {
        "gecko": {
            "id": "duckduckgo-lite@celenity.dev",
            "update_url": "https://phoenix.celenity.dev/extensions/updates.json"
        }
    },
    "hidden": true,
    "chrome_settings_overrides": {
        "search_provider": {
            "keyword": [
                "@duckduckgolite",
                "@ddglite"
            ],
            "name": "DuckDuckGo (Lite)",
            "search_url": "https://lite.duckduckgo.com/lite/?q={searchTerms}",
            "suggest_url": "https://duckduckgo.com/ac/?q={searchTerms}&type=list",
            "favicon_url": "/imager/favicon.ico",
            "is_default": false
        }
    },
    "author": "celenity 💘 <celenity@celenity.dev>",
    "homepage_url": "https://phoenix.celenity.dev",
    "icons": {
        "48": "imager/icon.png"
    }
}